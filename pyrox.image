import os
import requests

FAL_KEY = os.getenv("FAL_KEY", "").strip()

ENDPOINTS = {
    "flux1": "https://fal.run/fal-ai/flux/schnell",          # FLUX.1 (तेज़, कम खर्च)
    "ultra": "https://fal.run/fal-ai/flux-pro/v1.1-ultra",    # हाई-डिटेल / Ultra
}

ULTRA_HINTS = ("ultra", "4k", "8k", "high detail", "hyper realistic", "pro")

def _pick_model(prompt: str, mode: str = "auto") -> str:
    mode_clean = (mode or "auto").strip().lower()
    if mode_clean in ("ultra", "pro", "high"):
        return "ultra"
    if mode_clean in ("flux1", "fast", "normal"):
        return "flux1"
    # "auto" मोड में प्रॉम्प्ट देखकर ज़रूरत के हिसाब से चुनना
    p = (prompt or "").lower()
    return "ultra" if any(word in p for word in ULTRA_HINTS) else "flux1"

def _call_fal(endpoint_url: str, prompt: str, image_size: str = "square_hd") -> dict:
    if not FAL_KEY:
        return {"ok": False, "error": "FAL_KEY missing in environment"}
    headers = {
        "Authorization": f"Key {FAL_KEY}",
        "Content-Type": "application/json",
    }
    payload = {
        "prompt": prompt,
        "image_size": image_size,
        "num_images": 1,
        "enable_safety_checker": True,
    }
    res = requests.post(endpoint_url, json=payload, headers=headers, timeout=90)
    data = res.json()
    if res.status_code != 200:
        return {"ok": False, "error": data.get("detail") or str(data)}
    images = data.get("images") or []
    if not images or not images[0].get("url"):
        return {"ok": False, "error": "No image URL returned"}
    return {"ok": True, "url": images[0]["url"]}

def generate_image(prompt: str, mode: str = "auto", image_size: str = "square_hd") -> dict:
    chosen = _pick_model(prompt, mode)
    first = _call_fal(ENDPOINTS[chosen], prompt, image_size)
    if first["ok"]:
        return {"ok": True, "image_url": first["url"], "model_used": chosen}

    # अगर चुना हुआ मॉडल फेल हो जाए तो दूसरे पर fallback
    fallback = "ultra" if chosen == "flux1" else "flux1"
    second = _call_fal(ENDPOINTS[fallback], prompt, image_size)
    if second["ok"]:
        return {"ok": True, "image_url": second["url"], "model_used": fallback, "fallback": True}

    return {"ok": False, "error": second.get("error") or first.get("error")}
